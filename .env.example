# Add ONE of these (or both):
# Claude (paid): https://platform.claude.com
ANTHROPIC_API_KEY=
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model provider to use: anthropic or gemini (auto-detected from the key you set)
AGENT_PROVIDER=

# Optional: lets the agent work with your GitHub repos, issues and PRs
GITHUB_TOKEN=

# Optional settings (defaults shown)
# Model, blank = default (claude-sonnet-5 / gemini-flash-latest)
AGENT_MODEL=
AGENT_MAX_TOKENS=8000
AGENT_MAX_STEPS=30
AGENT_WORKSPACE=workspace
AGENT_MEMORY_FILE=~/.ai_agent/memory.json
AGENT_WEB_SEARCH=true
AGENT_AUTO_APPROVE=false
AGENT_COMMAND_TIMEOUT=60

# Web app (python app.py)
# Required to use the app from your phone or put it online. Pick something long.
APP_PASSWORD=
# Blocks shell, Python and deletes. Switches on automatically when the app is
# reachable from other devices; set to false only if you trust your network.
AGENT_SAFE_MODE=
